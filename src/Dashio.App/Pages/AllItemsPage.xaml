<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dashio.App.Pages.AllItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dashio.App"
    xmlns:vm="using:Dashio.App.ViewModels">

    <Page.Resources>
        <!-- A column heading that sorts when pressed. -->
        <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- The negative margin lets the hover highlight extend left while the label stays on the column edge. -->
            <Setter Property="Margin" Value="-8,0,0,0" />
            <Setter Property="Padding" Value="8,6,8,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- The right-click menu of a row. One menu serves every row; it is filled in as it opens. -->
        <MenuFlyout x:Key="RowMenu" Opening="RowMenu_Opening">
            <MenuFlyoutItem Click="OpenApp_Click" Text="Open app page">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="ToggleItem_Click"
                Tag="toggle"
                Text="Turn off">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7E8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="CopyName_Click" Text="Copy name">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="CopyCommand_Click"
                Tag="command"
                Text="Copy command" />
            <MenuFlyoutItem
                Click="RevealFile_Click"
                Tag="file"
                Text="Show file in File Explorer">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid x:Name="Shell" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="{StaticResource PageHeaderMargin}" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="All items" />
                <TextBlock
                    AutomationProperties.AutomationId="ItemsSummary"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox
                x:Name="KindBox"
                Grid.Column="1"
                MinWidth="200"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="KindFilter"
                AutomationProperties.Name="Show type"
                SelectedIndex="0"
                SelectionChanged="KindBox_SelectionChanged">
                <ComboBoxItem Content="All types" />
                <ComboBoxItem Content="Services" Tag="Service" />
                <ComboBoxItem Content="Scheduled tasks" Tag="ScheduledTask" />
                <ComboBoxItem Content="Startup entries" Tag="RunKey" />
                <ComboBoxItem Content="Startup folder" Tag="StartupFolder" />
                <ComboBoxItem Content="Store app startup" Tag="PackagedStartupTask" />
            </ComboBox>
        </Grid>

        <!-- Column headings. The widths match the row template below. -->
        <Grid
            Grid.Row="1"
            Margin="36,16,36,0"
            Padding="16,8,24,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            ColumnSpacing="8"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="1.8*" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="NameHeader"
                AutomationProperties.AutomationId="SortName"
                AutomationProperties.Name="Sort by name"
                Click="Header_Click"
                Content="Name"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="Name" />
            <Button
                x:Name="TypeHeader"
                Grid.Column="1"
                AutomationProperties.AutomationId="SortType"
                AutomationProperties.Name="Sort by type"
                Click="Header_Click"
                Content="Type"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="Type" />
            <Button
                x:Name="AppHeader"
                Grid.Column="2"
                AutomationProperties.AutomationId="SortApp"
                AutomationProperties.Name="Sort by app"
                Click="Header_Click"
                Content="App"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="App" />
            <Button
                x:Name="StartsHeader"
                Grid.Column="3"
                AutomationProperties.AutomationId="SortStarts"
                AutomationProperties.Name="Sort by when it starts"
                Click="Header_Click"
                Content="Starts"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="Starts" />
            <Button
                x:Name="StateHeader"
                Grid.Column="4"
                AutomationProperties.AutomationId="SortState"
                AutomationProperties.Name="Sort by state"
                Click="Header_Click"
                Content="State"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="State" />
        </Grid>

        <ListView
            Grid.Row="2"
            Padding="36,4,36,24"
            AutomationProperties.AutomationId="ItemTable"
            AutomationProperties.Name="All items"
            IsItemClickEnabled="True"
            ItemClick="Row_Click"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="None"
            Visibility="{x:Bind local:Ui.Collapsed(ViewModel.IsLoading), Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="16,0,24,0" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="ContextFlyout" Value="{StaticResource RowMenu}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemRowViewModel">
                    <Grid AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <FontIcon
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind AdminFoundLabel}"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE7EF;"
                                ToolTipService.ToolTip="{x:Bind AdminFoundLabel}"
                                Visibility="{x:Bind local:Ui.Visible(IsAdminFound)}" />
                        </Grid>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind KindGlyph}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind KindName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid Grid.Column="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xECAA;"
                                    Visibility="{x:Bind local:Ui.VisibleIfNull(AppIcon), Mode=OneWay}" />
                                <Image Source="{x:Bind AppIcon, Mode=OneWay}" Stretch="Uniform" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind AppName}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <StackPanel
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind TriggerGlyph}"
                                Visibility="{x:Bind local:Ui.Visible(IsEnabled)}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind StartsOrPending, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                ToolTipService.ToolTip="Running"
                                Visibility="{x:Bind local:Ui.Visible(IsRunning)}" />
                        </StackPanel>

                        <Grid Grid.Column="4" HorizontalAlignment="Left">
                            <!-- "On" is a fact, not good news, so it wears the accent rather than green. -->
                            <Border
                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                Style="{StaticResource BadgeStyle}"
                                Visibility="{x:Bind local:Ui.Visible(IsEnabled)}">
                                <TextBlock
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Style="{StaticResource BadgeTextStyle}"
                                    Text="On" />
                            </Border>
                            <Border
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Style="{StaticResource BadgeStyle}"
                                Visibility="{x:Bind local:Ui.Visible(IsDisabled)}">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BadgeTextStyle}"
                                    Text="Off" />
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing
            Grid.Row="2"
            Width="32"
            Height="32"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <StackPanel
            Grid.Row="2"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:Ui.Visible(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE721;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Nothing to show" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
