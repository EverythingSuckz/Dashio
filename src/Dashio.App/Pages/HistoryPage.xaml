<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dashio.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Dashio.App"
    xmlns:pages="using:Dashio.App.Pages"
    xmlns:vm="using:Dashio.App.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="BatchTemplate" x:DataType="vm:HistoryBatch">
            <Grid Margin="0,20,0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE787;" />
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Detail}" />
                </StackPanel>
                <HyperlinkButton
                    Grid.Column="1"
                    AutomationProperties.Name="{x:Bind UndoAllName}"
                    Click="UndoBatch_Click"
                    Content="Undo all"
                    Tag="{x:Bind}"
                    Visibility="{x:Bind local:Ui.Visible(CanUndoAll)}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EntryTemplate" x:DataType="vm:HistoryRow">
            <controls:SettingsCard AutomationProperties.Name="{x:Bind AccessibleName}">
                <controls:SettingsCard.Header>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- The result, as an icon whose colour and shape both carry the meaning. -->
                        <Grid
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center">
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;"
                                Visibility="{x:Bind local:Ui.Visible(IsApplied)}" />
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE783;"
                                Visibility="{x:Bind local:Ui.Visible(IsProblem)}" />
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE711;"
                                Visibility="{x:Bind local:Ui.Visible(IsCancelled)}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Subtitle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </controls:SettingsCard.Header>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Error}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:Ui.Visible(HasError)}" />
                    <Button
                        AutomationProperties.Name="{x:Bind UndoName}"
                        Click="Undo_Click"
                        Tag="{x:Bind}"
                        Visibility="{x:Bind local:Ui.Visible(CanUndo)}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                            <TextBlock Text="Undo" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:SettingsCard>
        </DataTemplate>

        <pages:HistoryRowTemplateSelector
            x:Key="RowSelector"
            BatchTemplate="{StaticResource BatchTemplate}"
            EntryTemplate="{StaticResource EntryTemplate}" />
    </Page.Resources>

    <Grid x:Name="Shell" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1112" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="{StaticResource PageHeaderMargin}" Spacing="4">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="History" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Every change Dashio has made on this PC. Undo puts an item back exactly as it was."
                TextWrapping="Wrap" />
            <InfoBar
                Margin="0,12,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSkippedLines, Mode=OneWay}"
                Message="{x:Bind ViewModel.SkippedText, Mode=OneWay}"
                Severity="Warning" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1112" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsRepeater
                    Margin="{StaticResource PageContentMargin}"
                    ItemTemplate="{StaticResource RowSelector}"
                    ItemsSource="{x:Bind ViewModel.Rows}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Grid.ColumnSpan="2"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="HistoryEmpty"
            Spacing="8"
            Visibility="{x:Bind local:Ui.Visible(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE81C;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="No changes yet" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="When you turn something off or on, it is recorded here so you can undo it."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
