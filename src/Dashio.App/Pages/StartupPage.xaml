<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dashio.App.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dashio.App"
    xmlns:vm="using:Dashio.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- The right-click menu of a row. One menu serves every row; it is filled in as it opens. -->
        <MenuFlyout x:Key="RowMenu" Opening="RowMenu_Opening">
            <MenuFlyoutItem Click="OpenApp_Click" Text="Open app page">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="ToggleItem_Click"
                Tag="toggle"
                Text="Turn off">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7E8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="StopItem_Click"
                Tag="stop"
                Text="Stop now">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE71A;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="CopyName_Click" Text="Copy name">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="CopyCommand_Click"
                Tag="command"
                Text="Copy command" />
            <MenuFlyoutItem
                Click="RevealFile_Click"
                Tag="file"
                Text="Show file in File Explorer">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid x:Name="Shell" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title on the left, the filter box on the right. -->
        <Grid
            Margin="{StaticResource PageHeaderMargin}"
            ColumnSpacing="24"
            RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Startup" />
                <TextBlock
                    AutomationProperties.AutomationId="StartupSummary"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <AutoSuggestBox
                x:Name="FilterBox"
                Grid.Column="1"
                Width="280"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="StartupFilter"
                AutomationProperties.Name="Filter startup items"
                PlaceholderText="Filter by item or app name"
                QueryIcon="Filter"
                TextChanged="FilterBox_TextChanged" />
        </Grid>

        <Grid
            Grid.Row="1"
            Margin="24,16,36,8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- One tab per way of starting. The labels carry the counts and are set in code. -->
            <SelectorBar
                x:Name="KindBar"
                AutomationProperties.Name="Which kind of item to show"
                SelectionChanged="KindBar_SelectionChanged">
                <SelectorBarItem
                    x:Name="KindAll"
                    AutomationProperties.AutomationId="KindAll"
                    IsSelected="True"
                    Tag=""
                    Text="All" />
                <SelectorBarItem
                    x:Name="KindService"
                    AutomationProperties.AutomationId="KindService"
                    Tag="Service"
                    Text="Services" />
                <SelectorBarItem
                    x:Name="KindScheduledTask"
                    AutomationProperties.AutomationId="KindScheduledTask"
                    Tag="ScheduledTask"
                    Text="Scheduled tasks" />
                <SelectorBarItem
                    x:Name="KindRunKey"
                    AutomationProperties.AutomationId="KindRunKey"
                    Tag="RunKey"
                    Text="Startup entries" />
                <SelectorBarItem
                    x:Name="KindStartupFolder"
                    AutomationProperties.AutomationId="KindStartupFolder"
                    Tag="StartupFolder"
                    Text="Startup folder" />
                <SelectorBarItem
                    x:Name="KindPackagedStartupTask"
                    AutomationProperties.AutomationId="KindPackagedStartupTask"
                    Tag="PackagedStartupTask"
                    Text="Store apps" />
            </SelectorBar>
            <!-- Appears when an app has added something to start by itself since Dashio first looked. -->
            <ToggleButton
                x:Name="NewToggle"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="StartupNewOnly"
                Click="NewToggle_Click"
                ToolTipService.ToolTip="Show only what was added in the last two weeks"
                Visibility="{x:Bind local:Ui.Visible(ViewModel.HasNew), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE735;" />
                    <TextBlock Text="{x:Bind ViewModel.NewLabel, Mode=OneWay}" />
                </StackPanel>
            </ToggleButton>
            <DropDownButton
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="StartupViewMenu"
                AutomationProperties.Name="View">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                    <TextBlock Text="View" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <ToggleMenuFlyoutItem
                            x:Name="ShowWindowsItem"
                            AutomationProperties.AutomationId="StartupShowWindowsItem"
                            Click="ShowWindows_Click"
                            Text="Show Windows components" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Column headings. The widths match the row template below. -->
        <Grid
            Grid.Row="2"
            Margin="36,0,36,0"
            Padding="16,4,16,4"
            ColumnSpacing="16"
            Style="{StaticResource TableHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="{x:Bind ViewModel.Columns.TypeWidth, Mode=OneWay}" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="{x:Bind ViewModel.Columns.StartsWidth, Mode=OneWay}" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="NameHeader"
                AutomationProperties.AutomationId="SortName"
                AutomationProperties.Name="Sort by name"
                Click="Header_Click"
                Content="Name"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="Name" />
            <Button
                x:Name="TypeHeader"
                Grid.Column="1"
                AutomationProperties.AutomationId="SortType"
                AutomationProperties.Name="Sort by type"
                Click="Header_Click"
                Content="Type"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="Type"
                Visibility="{x:Bind local:Ui.Visible(ViewModel.Columns.ShowType), Mode=OneWay}" />
            <Button
                x:Name="AppHeader"
                Grid.Column="2"
                AutomationProperties.AutomationId="SortApp"
                AutomationProperties.Name="Sort by app"
                Click="Header_Click"
                Content="App"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="App" />
            <Button
                x:Name="StartsHeader"
                Grid.Column="3"
                AutomationProperties.AutomationId="SortStarts"
                AutomationProperties.Name="Sort by when it starts"
                Click="Header_Click"
                Content="Starts"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="Starts"
                Visibility="{x:Bind local:Ui.Visible(ViewModel.Columns.ShowStarts), Mode=OneWay}" />
            <Button
                x:Name="MemoryHeader"
                Grid.Column="4"
                AutomationProperties.AutomationId="SortMemory"
                AutomationProperties.Name="Sort by memory in use"
                Click="Header_Click"
                Content="Memory"
                Style="{StaticResource ColumnHeaderRightButtonStyle}"
                Tag="Memory"
                ToolTipService.ToolTip="What the item's program is using right now" />
            <Button
                x:Name="StateHeader"
                Grid.Column="5"
                AutomationProperties.AutomationId="SortState"
                AutomationProperties.Name="Sort by state"
                Click="Header_Click"
                Content="Enabled"
                Style="{StaticResource ColumnHeaderRightButtonStyle}"
                Tag="State" />
        </Grid>

        <ListView
            x:Name="ItemList"
            Grid.Row="3"
            Padding="36,4,36,24"
            AutomationProperties.AutomationId="ItemTable"
            AutomationProperties.Name="Startup items"
            IsItemClickEnabled="True"
            ItemClick="Row_Click"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="None"
            Visibility="{x:Bind local:Ui.Collapsed(ViewModel.IsLoading), Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="16,0,16,0" />
                    <Setter Property="MinHeight" Value="48" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="ContextFlyout" Value="{StaticResource RowMenu}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemRowViewModel">
                    <Grid AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="{x:Bind Columns.TypeWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="{x:Bind Columns.StartsWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Running now: the same dot as on the other pages. -->
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                ToolTipService.ToolTip="Running now"
                                Visibility="{x:Bind local:Ui.Visible(IsRunningNow), Mode=OneWay}" />
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                StrokeThickness="1"
                                ToolTipService.ToolTip="Not running"
                                Visibility="{x:Bind local:Ui.Collapsed(IsRunningNow), Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <StackPanel
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4"
                                ToolTipService.ToolTip="{x:Bind NewTip}"
                                Visibility="{x:Bind local:Ui.Visible(IsNew)}">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE735;" />
                                <TextBlock
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="New" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="3"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind AdminFoundLabel}"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE7EF;"
                                ToolTipService.ToolTip="{x:Bind AdminFoundLabel}"
                                Visibility="{x:Bind local:Ui.Visible(IsAdminFound)}" />
                        </Grid>

                        <Grid
                            Grid.Column="1"
                            ColumnSpacing="8"
                            ToolTipService.ToolTip="{x:Bind KindName}"
                            Visibility="{x:Bind local:Ui.Visible(Columns.ShowType), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind KindGlyph}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind KindName}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>

                        <Grid Grid.Column="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xECAA;"
                                    Visibility="{x:Bind local:Ui.VisibleIfNull(AppIcon), Mode=OneWay}" />
                                <Image Source="{x:Bind AppIcon, Mode=OneWay}" Stretch="Uniform" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind AppName}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid
                            Grid.Column="3"
                            ColumnSpacing="8"
                            Visibility="{x:Bind local:Ui.Visible(Columns.ShowStarts), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind TriggerGlyph}"
                                Visibility="{x:Bind local:Ui.Visible(IsEnabled)}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind StartsOrPending, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>

                        <!-- What starting by itself costs right now. -->
                        <Grid Grid.Column="4" ToolTipService.ToolTip="{x:Bind MemoryTip, Mode=OneWay}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind MemoryText, Mode=OneWay}"
                                TextAlignment="Right"
                                Visibility="{x:Bind local:Ui.Visible(IsRunningNow), Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind MemoryText, Mode=OneWay}"
                                TextAlignment="Right"
                                Visibility="{x:Bind local:Ui.Collapsed(IsRunningNow), Mode=OneWay}" />
                        </Grid>

                        <!-- The switch queues the change; nothing happens until it is applied. -->
                        <StackPanel
                            Grid.Column="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Needs administrator permission to change"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xEA18;"
                                ToolTipService.ToolTip="Needs administrator permission to change"
                                Visibility="{x:Bind local:Ui.Visible(NeedsAdmin)}" />
                            <FontIcon
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Part of Windows"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE72E;"
                                ToolTipService.ToolTip="Part of Windows. Shown for reference; it cannot be changed here."
                                Visibility="{x:Bind local:Ui.Visible(IsWindowsComponent)}" />
                            <ToggleSwitch
                                MinWidth="0"
                                AutomationProperties.Name="{x:Bind Name}"
                                IsEnabled="{x:Bind CanChange}"
                                IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing
            Grid.Row="3"
            Width="32"
            Height="32"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <StackPanel
            Grid.Row="3"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:Ui.Visible(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE721;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Nothing to show" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
