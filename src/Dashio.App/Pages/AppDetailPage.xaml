<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dashio.App.Pages.AppDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Dashio.App"
    xmlns:pages="using:Dashio.App.Pages"
    xmlns:vm="using:Dashio.App.ViewModels">

    <Page.Resources>
        <!-- A small borderless button for an action on one detail line. -->
        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <DataTemplate x:Key="HeaderTemplate" x:DataType="vm:SectionHeader">
            <Grid Margin="0,24,0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Top"
                    FontSize="20"
                    Glyph="{x:Bind Glyph}" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title}" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" Style="{StaticResource BadgeStyle}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BadgeTextStyle}"
                                Text="{x:Bind Detail}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Explanation}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One line of an item's details: icon, label, formatted value, then a verdict and actions. -->
        <DataTemplate x:Key="DetailRowTemplate" x:DataType="vm:DetailRow">
            <Grid
                Padding="0,12,0,12"
                AutomationProperties.Name="{x:Bind AccessibleName}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="{x:Bind Divider}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Margin="0,2,0,0"
                    VerticalAlignment="Top"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind Glyph}" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Label}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="2"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Value}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:Ui.Visible(IsText)}" />
                <TextBlock
                    Grid.Column="2"
                    FontFamily="{StaticResource CodeFontFamily}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Value}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:Ui.Visible(IsCode)}" />

                <StackPanel
                    Grid.Column="3"
                    Margin="0,-6,0,-6"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Border
                        Margin="0,6,0,6"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        Style="{StaticResource BadgeStyle}"
                        Visibility="{x:Bind local:Ui.Visible(IsGood)}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Style="{StaticResource BadgeTextStyle}"
                                Text="Trusted" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="0,6,0,6"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        Style="{StaticResource BadgeStyle}"
                        Visibility="{x:Bind local:Ui.Visible(IsWarning)}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xE7BA;" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{StaticResource BadgeTextStyle}"
                                Text="Worth checking" />
                        </StackPanel>
                    </Border>
                    <Button
                        AutomationProperties.Name="{x:Bind CopyName}"
                        Click="CopyDetail_Click"
                        Style="{StaticResource RowActionButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Copy"
                        Visibility="{x:Bind local:Ui.Visible(CanCopy)}">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Show in File Explorer"
                        Click="RevealDetail_Click"
                        Style="{StaticResource RowActionButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Show in File Explorer"
                        Visibility="{x:Bind local:Ui.Visible(CanReveal)}">
                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AboutRowTemplate" x:DataType="vm:AboutRow">
            <Grid AutomationProperties.Name="{x:Bind AccessibleName}" Style="{StaticResource PanelRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource RowIconTileStyle}">
                    <FontIcon FontSize="20" Glyph="{x:Bind Glyph}" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Label}" />
                    <TextBlock Text="{x:Bind Value}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ItemTemplate" x:DataType="vm:ItemRowViewModel">
            <controls:SettingsExpander AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" Header="{x:Bind Name}">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="{x:Bind KindGlyph}" />
                </controls:SettingsExpander.HeaderIcon>

                <!-- The status line: when it starts, whether it is running, and any queued change. -->
                <controls:SettingsExpander.Description>
                    <StackPanel
                        Margin="0,2,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind local:Ui.Visible(IsSettled), Mode=OneWay}">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind TriggerGlyph}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind StartsLabel}" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind local:Ui.Visible(ShowRunning), Mode=OneWay}">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Running" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind local:Ui.Visible(ShowStillRunning), Mode=OneWay}">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Still running" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind local:Ui.Visible(IsPending), Mode=OneWay}">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE70F;" />
                            <TextBlock
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind PendingLabel, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind local:Ui.Visible(IsAdminFound)}">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE7EF;" />
                            <TextBlock
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind AdminFoundLabel}" />
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsExpander.Description>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind StopName}"
                        Click="StopItem_Click"
                        Content="Stop"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Stops this service now. Its start setting stays as it is, so it starts again as before."
                        Visibility="{x:Bind local:Ui.Visible(CanStopNow)}" />
                    <FontIcon
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Needs administrator permission to change"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xEA18;"
                        ToolTipService.ToolTip="Needs administrator permission to change"
                        Visibility="{x:Bind local:Ui.Visible(NeedsAdmin)}" />
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4"
                        Visibility="{x:Bind local:Ui.Visible(IsWindowsComponent)}">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72E;" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Part of Windows" />
                    </StackPanel>
                    <ToggleSwitch
                        MinWidth="0"
                        AutomationProperties.Name="{x:Bind Name}"
                        IsEnabled="{x:Bind CanChange}"
                        IsOn="{x:Bind IsOn, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On"
                        Visibility="{x:Bind local:Ui.Collapsed(IsWindowsComponent)}" />
                </StackPanel>

                <controls:SettingsExpander.ItemsHeader>
                    <StackPanel>
                        <InfoBar
                            Title="Hardware may need this"
                            BorderThickness="0"
                            CornerRadius="0"
                            IsClosable="False"
                            IsOpen="{x:Bind HasDriverWarning}"
                            Message="This service was installed with a device driver. Turning it off can stop a hardware feature from working. You can turn it back on from History."
                            Severity="Warning" />
                        <InfoBar
                            Title="Hidden task"
                            BorderThickness="0"
                            CornerRadius="0"
                            IsClosable="False"
                            IsOpen="{x:Bind IsHiddenTask}"
                            Message="This task is in the registry but Task Scheduler does not list it, so Dashio cannot switch it. Hiding a task this way is unusual and worth a closer look."
                            Severity="Warning" />
                        <InfoBar
                            Title="Only visible with administrator rights"
                            BorderThickness="0"
                            CornerRadius="0"
                            IsClosable="False"
                            IsOpen="{x:Bind IsAdminOnly}"
                            Message="The normal scan could not see this task. It was found by the admin scan."
                            Severity="Informational" />
                        <InfoBar
                            Title="The file is missing"
                            BorderThickness="0"
                            CornerRadius="0"
                            IsClosable="False"
                            IsOpen="{x:Bind IsMissingFile}"
                            Message="This entry points to a file that no longer exists. It is probably left over from an uninstalled app."
                            Severity="Informational" />
                    </StackPanel>
                </controls:SettingsExpander.ItemsHeader>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                        <ItemsRepeater ItemTemplate="{StaticResource DetailRowTemplate}" ItemsSource="{x:Bind Details}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </DataTemplate>

        <pages:DetailRowTemplateSelector
            x:Key="RowSelector"
            HeaderTemplate="{StaticResource HeaderTemplate}"
            ItemTemplate="{StaticResource ItemTemplate}" />
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <Grid x:Name="Shell" HorizontalAlignment="Center" Padding="36,24,36,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Top">
                    <!-- Who this is -->
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                        <Grid Padding="24" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="56"
                                Height="56"
                                VerticalAlignment="Top">
                                <FontIcon
                                    FontSize="40"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xECAA;"
                                    Visibility="{x:Bind local:Ui.VisibleIfNull(ViewModel.Icon), Mode=OneWay}" />
                                <Image Source="{x:Bind ViewModel.Icon, Mode=OneWay}" Stretch="Uniform" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    AutomationProperties.AutomationId="DetailTitle"
                                    AutomationProperties.HeadingLevel="Level1"
                                    Style="{StaticResource TitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.Publisher, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    Margin="0,10,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" Style="{StaticResource BadgeStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE7E8;" />
                                            <TextBlock
                                                AutomationProperties.AutomationId="DetailSummary"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource BadgeTextStyle}"
                                                Text="{x:Bind ViewModel.StartsText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        Style="{StaticResource BadgeStyle}"
                                        Visibility="{x:Bind local:Ui.Visible(ViewModel.IsRunning), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Glyph="&#xE768;" />
                                            <TextBlock
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Style="{StaticResource BadgeTextStyle}"
                                                Text="{x:Bind ViewModel.RunningText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        Style="{StaticResource BadgeStyle}"
                                        ToolTipService.ToolTip="Starts with Windows in a way Task Manager's Startup tab does not list"
                                        Visibility="{x:Bind local:Ui.Visible(ViewModel.IsHidden), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Glyph="&#xED1A;" />
                                            <TextBlock
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Style="{StaticResource BadgeTextStyle}"
                                                Text="Not in Task Manager" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- What can be done with the app. -->
                        <Border
                            Padding="24,12,24,12"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="{x:Bind local:Ui.Visible(ViewModel.HasActions), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="TurnAllButton"
                                AutomationProperties.AutomationId="TurnAllButton"
                                AutomationProperties.Name="{x:Bind ViewModel.TurnAllLabel, Mode=OneWay}"
                                Click="TurnAll_Click"
                                IsEnabled="{x:Bind ViewModel.CanTurnAll, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.TurnAllTip, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Visible(ViewModel.HasItems), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.TurnAllGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.TurnAllLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.AutomationId="EndAppButton"
                                AutomationProperties.Name="End app"
                                Click="EndApp_Click"
                                ToolTipService.ToolTip="Closes everything this app is running. Anything unsaved in it is lost."
                                Visibility="{x:Bind local:Ui.Visible(ViewModel.CanEndApp), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                                    <TextBlock Text="End app" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.AutomationId="ShowLocationButton"
                                AutomationProperties.Name="Show in File Explorer"
                                Click="ShowLocation_Click"
                                ToolTipService.ToolTip="Opens the folder this app runs from"
                                Visibility="{x:Bind local:Ui.Visible(ViewModel.HasLocation), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                                    <TextBlock Text="Show in File Explorer" />
                                </StackPanel>
                            </Button>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </Border>

                    <InfoBar
                        Margin="0,16,0,0"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasNote, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Note, Mode=OneWay}"
                        Severity="Informational" />

                    <ItemsRepeater ItemTemplate="{StaticResource RowSelector}" ItemsSource="{x:Bind ViewModel.Rows}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <!-- What the app is running at this moment, updated live. -->
                    <StackPanel Visibility="{x:Bind local:Ui.Visible(ViewModel.HasUsage), Mode=OneWay}">
                        <Grid Margin="0,24,0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Top"
                                FontSize="20"
                                Glyph="&#xE9D9;" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Running now" />
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Style="{StaticResource BadgeStyle}"
                                        Visibility="{x:Bind local:Ui.Visible(ViewModel.IsRunningNow), Mode=OneWay}">
                                        <TextBlock
                                            AutomationProperties.AutomationId="DetailUsage"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BadgeTextStyle}"
                                            Text="{x:Bind ViewModel.UsageSummary, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="The programs of this app that are running, with the memory and processor each is using."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource PanelStyle}" Visibility="{x:Bind local:Ui.Visible(ViewModel.IsRunningNow), Mode=OneWay}">
                            <StackPanel>
                                <Grid Padding="20,12,20,12" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Program" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Memory"
                                        TextAlignment="Right" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Processor"
                                        TextAlignment="Right" />
                                </Grid>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Processes}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProcessRowViewModel">
                                            <Grid
                                                Padding="20,10,20,10"
                                                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0"
                                                ColumnSpacing="16"
                                                ToolTipService.ToolTip="{x:Bind Path}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="76" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Detail}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Memory, Mode=OneWay}"
                                                    TextAlignment="Right" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Cpu, Mode=OneWay}"
                                                    TextAlignment="Right" />
                                                <StackPanel
                                                    Grid.Column="3"
                                                    Margin="0,-6,-8,-6"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <Button
                                                        AutomationProperties.Name="{x:Bind RevealName}"
                                                        Click="RevealProcess_Click"
                                                        Style="{StaticResource RowActionButtonStyle}"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Show in File Explorer"
                                                        Visibility="{x:Bind local:Ui.Visible(HasPath)}">
                                                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                                                    </Button>
                                                    <Button
                                                        AutomationProperties.Name="{x:Bind EndName}"
                                                        Click="EndProcess_Click"
                                                        Style="{StaticResource RowActionButtonStyle}"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="End this process"
                                                        Visibility="{x:Bind local:Ui.Visible(CanEnd)}">
                                                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock
                                    Padding="20,12,20,12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.MoreProcesses, Mode=OneWay}"
                                    Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.MoreProcesses), Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Margin="32,0,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Nothing of this app is running at the moment."
                            Visibility="{x:Bind local:Ui.Visible(ViewModel.IsNotRunningNow), Mode=OneWay}" />
                    </StackPanel>

                    <!-- Where the app's files are and how much room each folder takes. -->
                    <StackPanel Visibility="{x:Bind local:Ui.Visible(ViewModel.HasFolders), Mode=OneWay}">
                        <Grid Margin="0,24,0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Top"
                                FontSize="20"
                                Glyph="&#xEDA2;" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Storage" />
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" Style="{StaticResource BadgeStyle}">
                                        <TextBlock
                                            AutomationProperties.AutomationId="DetailStorage"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BadgeTextStyle}"
                                            Text="{x:Bind ViewModel.StorageSummary, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="The app's own files, and the data it keeps in your user folders."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource PanelStyle}">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FolderRow">
                                        <Grid
                                            Padding="20,10,12,10"
                                            AutomationProperties.Name="{x:Bind AccessibleName}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1"
                                            ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Kind}" />
                                                <TextBlock
                                                    FontFamily="{StaticResource CodeFontFamily}"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind Path}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Size}"
                                                TextAlignment="Right" />
                                            <Button
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind RevealName}"
                                                Click="OpenFolder_Click"
                                                Style="{StaticResource RowActionButtonStyle}"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Open in File Explorer">
                                                <FontIcon FontSize="14" Glyph="&#xE838;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Border>
                    </StackPanel>

                    <!-- What Windows knows about this app, under the items when there is no room beside them. -->
                    <Border
                        x:Name="AboutNarrow"
                        Margin="0,24,0,0"
                        Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock
                                Padding="20,20,20,16"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="About this app" />
                            <ItemsRepeater ItemTemplate="{StaticResource AboutRowTemplate}" ItemsSource="{x:Bind ViewModel.About, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- The same panel, beside the items on wide windows. -->
                <Border
                    x:Name="AboutWide"
                    Grid.Column="1"
                    Width="{StaticResource SidePanelWidth}"
                    Margin="24,0,0,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource PanelStyle}"
                    Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock
                            Padding="20,20,20,16"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="About this app" />
                        <ItemsRepeater ItemTemplate="{StaticResource AboutRowTemplate}" ItemsSource="{x:Bind ViewModel.About, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
