<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dashio.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Dashio.App.Controls"
    xmlns:local="using:Dashio.App"
    xmlns:vm="using:Dashio.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- A card that is a button: one of the three startup numbers. -->
        <Style
            x:Key="TileButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- A row inside a panel that opens something when pressed. -->
        <Style
            x:Key="PanelRowButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="20,10,20,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- The right-click menu of an app in the lists. One menu serves every row; the page fills it in and shows it. -->
        <MenuFlyout x:Key="UsageMenu">
            <MenuFlyoutItem Click="UsageOpen_Click" Text="Open">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="UsageReveal_Click"
                Tag="file"
                Text="Show file in File Explorer">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="UsageCopyName_Click" Text="Copy name">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="UsageEnd_Click"
                Tag="end"
                Text="End app">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE711;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="UsageToggleAll_Click"
                Tag="toggle"
                Text="Turn off everything it starts">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7E8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!-- One app in a "using the most" list: icon, name over a bar, and the figure. -->
        <DataTemplate x:Key="UsageRowTemplate" x:DataType="vm:UsageRowViewModel">
            <Button
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                Click="UsageRow_Click"
                ContextRequested="UsageRow_ContextRequested"
                Style="{StaticResource PanelRowButtonStyle}"
                Tag="{x:Bind}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center">
                        <FontIcon
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xECAA;"
                            Visibility="{x:Bind local:Ui.VisibleIfNull(Icon), Mode=OneWay}" />
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Detail, Mode=OneWay}" />
                        </Grid>
                        <ProgressBar
                            AutomationProperties.AccessibilityView="Raw"
                            Maximum="100"
                            Value="{x:Bind Share, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        MinWidth="64"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Value, Mode=OneWay}"
                        TextAlignment="Right" />
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <Grid
            x:Name="Shell"
            Padding="36,24,36,24"
            HorizontalAlignment="Center"
            ColumnSpacing="24"
            RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Top" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock
                        AutomationProperties.AutomationId="OverviewTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Overview" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="What this PC is running right now, and what starts by itself."
                        TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar
                    Title="Live figures are paused"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
                    Message="The numbers below were measured when you opened this page."
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button
                            AutomationProperties.AutomationId="OverviewOpenSettings"
                            AutomationProperties.Name="Open Settings"
                            Click="OpenSettings_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE713;" />
                                <TextBlock Text="Open Settings" />
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Memory and processor, each with the last minute as a graph. -->
                <Grid
                    x:Name="MeterGrid"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Border Style="{StaticResource PanelStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.MemoryTip, Mode=OneWay}">
                        <StackPanel>
                            <Grid Margin="20,20,20,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileStyle}">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="&#xE950;" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Memory" />
                                    <Grid Height="56">
                                        <StackPanel Visibility="{x:Bind local:Ui.Visible(ViewModel.HasReading), Mode=OneWay}">
                                            <TextBlock
                                                AutomationProperties.AutomationId="OverviewMemory"
                                                Style="{StaticResource TitleTextBlockStyle}"
                                                Text="{x:Bind ViewModel.MemoryValue, Mode=OneWay}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.MemoryDetail, Mode=OneWay}" />
                                        </StackPanel>
                                        <ProgressRing
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            IsActive="{x:Bind local:Ui.Not(ViewModel.HasReading), Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <app:Sparkline
                                x:Name="MemoryChart"
                                Height="64"
                                Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.CpuTip, Mode=OneWay}">
                        <StackPanel>
                            <Grid Margin="20,20,20,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileStyle}">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="&#xE9D9;" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Processor" />
                                    <Grid Height="56">
                                        <StackPanel Visibility="{x:Bind local:Ui.Visible(ViewModel.HasReading), Mode=OneWay}">
                                            <TextBlock
                                                AutomationProperties.AutomationId="OverviewCpu"
                                                Style="{StaticResource TitleTextBlockStyle}"
                                                Text="{x:Bind ViewModel.CpuValue, Mode=OneWay}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="of the processor in use" />
                                        </StackPanel>
                                        <ProgressRing
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            IsActive="{x:Bind local:Ui.Not(ViewModel.HasReading), Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <app:Sparkline
                                x:Name="CpuChart"
                                Height="64"
                                Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <Grid Margin="20,20,20,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileStyle}">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="&#xEDA2;" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Windows drive" />
                                    <StackPanel Height="56">
                                        <TextBlock
                                            AutomationProperties.AutomationId="OverviewDisk"
                                            Style="{StaticResource TitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.DiskValue, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.DiskDetail, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <!-- As tall as the graphs beside it, so the three cards line up. -->
                            <Grid Height="64" Padding="20,0,20,0">
                                <ProgressBar
                                    MinHeight="8"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Share of the Windows drive in use"
                                    CornerRadius="4"
                                    Maximum="100"
                                    Value="{x:Bind ViewModel.DiskUsedPercent, Mode=OneWay}">
                                    <!-- As thick as the drive bars on the Storage page. -->
                                    <ProgressBar.Resources>
                                        <x:Double x:Key="ProgressBarMinHeight">8</x:Double>
                                        <x:Double x:Key="ProgressBarTrackHeight">8</x:Double>
                                        <CornerRadius x:Key="ProgressBarCornerRadius">4</CornerRadius>
                                        <CornerRadius x:Key="ProgressBarTrackCornerRadius">4</CornerRadius>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- What starts by itself. Each tile opens the page that lists what it counts. -->
                <Grid
                    x:Name="TileGrid"
                    ColumnSpacing="16"
                    RowSpacing="8">
                    <Button
                        AutomationProperties.AutomationId="TileAtStartup"
                        AutomationProperties.Name="{x:Bind ViewModel.AtStartupName, Mode=OneWay}"
                        Click="AtStartupTile_Click"
                        Style="{StaticResource TileButtonStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIconTileStyle}">
                                <FontIcon FontSize="18" Glyph="&#xE7E8;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Height="28">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.AtStartupCount, Mode=OneWay}"
                                        Visibility="{x:Bind local:Ui.Collapsed(ViewModel.IsLoadingStartup), Mode=OneWay}" />
                                    <ProgressRing
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        IsActive="{x:Bind ViewModel.IsLoadingStartup, Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="apps start with Windows"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                    <Button
                        AutomationProperties.AutomationId="TileNotInTaskManager"
                        AutomationProperties.Name="{x:Bind ViewModel.HiddenName, Mode=OneWay}"
                        Click="HiddenTile_Click"
                        Style="{StaticResource TileButtonStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIconTileStyle}">
                                <FontIcon FontSize="18" Glyph="&#xED1A;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Height="28">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.HiddenCount, Mode=OneWay}"
                                        Visibility="{x:Bind local:Ui.Collapsed(ViewModel.IsLoadingStartup), Mode=OneWay}" />
                                    <ProgressRing
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        IsActive="{x:Bind ViewModel.IsLoadingStartup, Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="not in Task Manager"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                    <Button
                        AutomationProperties.AutomationId="TileRunning"
                        AutomationProperties.Name="{x:Bind ViewModel.RunningName, Mode=OneWay}"
                        Click="RunningTile_Click"
                        Style="{StaticResource TileButtonStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIconTileStyle}">
                                <FontIcon FontSize="18" Glyph="&#xE768;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Height="28">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.RunningCount, Mode=OneWay}"
                                        Visibility="{x:Bind local:Ui.Collapsed(ViewModel.IsLoadingStartup), Mode=OneWay}" />
                                    <ProgressRing
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        IsActive="{x:Bind ViewModel.IsLoadingStartup, Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="services running now"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- Which apps are using the most, right now. -->
                <Grid
                    x:Name="TopGrid"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <Grid Padding="20,16,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="Using the most memory" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Each app with everything it is running, largest first"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <HyperlinkButton
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="OverviewOpenProcessesMemory"
                                    AutomationProperties.Name="See everything that is running"
                                    Click="OpenProcesses_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="See all" />
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Glyph="&#xE76C;" />
                                        </StackPanel>
                                </HyperlinkButton>
                            </Grid>
                            <ItemsRepeater
                                x:Name="TopMemoryList"
                                Margin="0,0,0,8"
                                ItemTemplate="{StaticResource UsageRowTemplate}"
                                ItemsSource="{x:Bind ViewModel.TopMemory}" />
                            <ProgressRing
                                Width="24"
                                Height="24"
                                Margin="0,24,0,32"
                                IsActive="{x:Bind ViewModel.IsLoadingApps, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Visible(ViewModel.IsLoadingApps), Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <Grid Padding="20,16,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="Using the most processor" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Share of the whole processor, busiest first"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <HyperlinkButton
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="OverviewOpenProcessesCpu"
                                    AutomationProperties.Name="See everything that is running"
                                    Click="OpenProcesses_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="See all" />
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Glyph="&#xE76C;" />
                                        </StackPanel>
                                </HyperlinkButton>
                            </Grid>
                            <ItemsRepeater
                                x:Name="TopCpuList"
                                Margin="0,0,0,8"
                                ItemTemplate="{StaticResource UsageRowTemplate}"
                                ItemsSource="{x:Bind ViewModel.TopCpu}" />
                            <ProgressRing
                                Width="24"
                                Height="24"
                                Margin="0,24,0,32"
                                IsActive="{x:Bind ViewModel.IsLoadingApps, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Visible(ViewModel.IsLoadingApps), Mode=OneWay}" />
                            <TextBlock
                                Padding="20,4,20,24"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Nothing is using the processor much right now."
                                TextWrapping="Wrap"
                                Visibility="{x:Bind local:Ui.Visible(ViewModel.IsCpuQuiet), Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- What is installed: the largest apps, and the ones nobody opens. -->
                <Grid
                    x:Name="InstalledGrid"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <Grid Padding="20,16,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="Taking the most space" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.StorageCaption, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <HyperlinkButton
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="OverviewOpenStorage"
                                    AutomationProperties.Name="See how much space every app takes"
                                    Click="OpenStorage_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="See all" />
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Glyph="&#xE76C;" />
                                        </StackPanel>
                                </HyperlinkButton>
                            </Grid>
                            <ItemsRepeater
                                Margin="0,0,0,8"
                                ItemTemplate="{StaticResource UsageRowTemplate}"
                                ItemsSource="{x:Bind ViewModel.TopStorage}" />
                            <ProgressRing
                                Width="24"
                                Height="24"
                                Margin="0,24,0,32"
                                IsActive="{x:Bind ViewModel.IsLoadingInstalled, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Visible(ViewModel.IsLoadingInstalled), Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Padding="20,16,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="Not opened lately" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.UnusedCaption, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <HyperlinkButton
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="OverviewOpenUnused"
                                    AutomationProperties.Name="See all apps not opened lately"
                                    Click="OpenUnused_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="See all" />
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Glyph="&#xE76C;" />
                                        </StackPanel>
                                </HyperlinkButton>
                            </Grid>
                            <ItemsRepeater
                                Grid.Row="1"
                                Margin="0,0,0,8"
                                VerticalAlignment="Top"
                                ItemTemplate="{StaticResource UsageRowTemplate}"
                                ItemsSource="{x:Bind ViewModel.TopUnused}" />
                            <ProgressRing
                                Grid.Row="1"
                                Width="24"
                                Height="24"
                                Margin="0,24,0,32"
                                IsActive="{x:Bind ViewModel.IsLoadingInstalled, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Visible(ViewModel.IsLoadingInstalled), Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                Padding="20,4,20,24"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.UnusedNote, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.UnusedNote), Mode=OneWay}" />
                            <!-- Nothing can be said until an administrator lets Dashio read what Windows has run. -->
                            <StackPanel
                                Grid.Row="1"
                                MaxWidth="380"
                                Margin="20,8,20,28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="4"
                                Visibility="{x:Bind local:Ui.Visible(ViewModel.NeedsAdminCheck), Mode=OneWay}">
                                <Border
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource RowIconTileStyle}">
                                    <FontIcon FontSize="20" Glyph="&#xEA18;" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Administrator access needed" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Windows only lets an administrator see which programs it has run lately. Dashio needs that list to tell which apps you have not opened."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="GrantAccessButton"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="OverviewGrantAccess"
                                    AutomationProperties.Name="Grant administrator access"
                                    Click="GrantAccess_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xEA18;" />
                                        <TextBlock Text="Grant access" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Beside the main column on wide windows, under it otherwise. -->
            <Grid
                x:Name="SidePanel"
                Grid.Row="1"
                VerticalAlignment="Top"
                ColumnSpacing="16"
                RowSpacing="16">
                <Border VerticalAlignment="Top" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <Grid Padding="20,16,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="What starts" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="How many of each kind are switched on"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <HyperlinkButton
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="OverviewOpenStartup"
                                AutomationProperties.Name="Open Startup"
                                Click="OpenStartup_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Startup" />
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Glyph="&#xE76C;" />
                                    </StackPanel>
                            </HyperlinkButton>
                        </Grid>
                        <!-- Something an app has added since Dashio first looked is worth a glance. -->
                        <HyperlinkButton
                            Margin="8,-4,12,4"
                            AutomationProperties.AutomationId="OverviewNewItems"
                            Click="NewItems_Click"
                            Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.NewItemsText), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE735;" />
                                <TextBlock Text="{x:Bind ViewModel.NewItemsText, Mode=OneWay}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Glyph="&#xE76C;" />
                            </StackPanel>
                        </HyperlinkButton>
                        <!-- One row per way of starting: how many are on, as a bar. Pressing it lists them. -->
                        <ItemsRepeater Margin="0,0,0,8" ItemsSource="{x:Bind ViewModel.Kinds, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:KindBreakdown">
                                    <Button
                                        Padding="20,10,12,10"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind AccessibleName}"
                                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                        BorderThickness="0"
                                        Click="KindRow_Click"
                                        CornerRadius="0"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind Explanation}">
                                        <Grid ColumnSpacing="12" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <FontIcon
                                                Grid.RowSpan="2"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="{x:Bind Glyph}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind CountText}" />
                                            <ProgressBar
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Maximum="100"
                                                Value="{x:Bind Percent}" />
                                            <FontIcon
                                                Grid.RowSpan="2"
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE76C;" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <ProgressRing
                            Width="24"
                            Height="24"
                            Margin="0,8,0,32"
                            IsActive="{x:Bind ViewModel.IsLoadingStartup, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Visible(ViewModel.IsLoadingStartup), Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border VerticalAlignment="Top" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <Grid Padding="20,16,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Recent changes" />
                            <HyperlinkButton
                                Grid.Column="1"
                                AutomationProperties.AutomationId="OverviewOpenHistory"
                                AutomationProperties.Name="Open History"
                                Click="OpenHistory_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="History" />
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Glyph="&#xE76C;" />
                                    </StackPanel>
                            </HyperlinkButton>
                        </Grid>
                        <!-- A short timeline: newest first, joined by a line down the icons. -->
                        <ItemsRepeater Margin="0,0,0,12" ItemsSource="{x:Bind ViewModel.Recent, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentChange">
                                    <Grid
                                        Padding="20,0,20,0"
                                        AutomationProperties.Name="{x:Bind AccessibleName}"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="1"
                                            Margin="0,28,0,0"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            Visibility="{x:Bind local:Ui.Visible(HasNext)}" />
                                        <Border
                                            Width="28"
                                            Height="28"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="14">
                                            <FontIcon FontSize="12" Glyph="{x:Bind Glyph}" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="0,3,0,16"
                                            Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind AppName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind When}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock
                            Padding="20,0,20,20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Nothing has been changed yet. Switches you flip are listed here, and each one can be undone."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:Ui.Visible(ViewModel.HasNoRecent), Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
