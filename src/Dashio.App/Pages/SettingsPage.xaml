<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dashio.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <Grid x:Name="Shell" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1112" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="36,24,36,24" Spacing="4">
                <TextBlock
                    Margin="0,0,0,12"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />

                <TextBlock
                    Margin="0,0,0,4"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="General" />
                <controls:SettingsCard Description="Choose light or dark, or follow Windows." Header="Theme">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="ThemeBox"
                        MinWidth="180"
                        AutomationProperties.AutomationId="ThemeBox"
                        AutomationProperties.Name="Theme"
                        SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem Content="Use Windows setting" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Description="Opens Dashio when you sign in. It is an ordinary startup entry, so it also shows on the Startup page." Header="Start with Windows">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="StartWithWindowsSwitch"
                        MinWidth="0"
                        AutomationProperties.AutomationId="StartWithWindowsSwitch"
                        AutomationProperties.Name="Start with Windows"
                        Toggled="StartWithWindows_Toggled" />
                </controls:SettingsCard>

                <TextBlock
                    Margin="0,20,0,4"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="What is shown" />
                <controls:SettingsCard Description="Lists the parts of Windows itself. They are shown for reference and cannot be changed." Header="Show Windows components">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE890;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="ShowWindowsSwitch"
                        MinWidth="0"
                        AutomationProperties.AutomationId="ShowWindowsSwitch"
                        AutomationProperties.Name="Show Windows components"
                        Toggled="ShowWindows_Toggled" />
                </controls:SettingsCard>
                <controls:SettingsCard Description="Dashio reads what is installed and what starts by itself when it opens, and again when you come back to it after a few minutes. F5 does the same." Header="Scan again now">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="RescanButton"
                        AutomationProperties.AutomationId="RescanButton"
                        AutomationProperties.Name="Scan again now"
                        Click="Rescan_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="Scan" />
                        </StackPanel>
                    </Button>
                </controls:SettingsCard>
                <controls:SettingsCard Description="Some scheduled tasks are hidden from ordinary apps. This asks for administrator permission once, then lists those tasks until the next scan." Header="Scan with administrator rights">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEA18;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing
                            x:Name="AdminScanRing"
                            Width="16"
                            Height="16"
                            IsActive="False" />
                        <Button
                            x:Name="AdminScanButton"
                            AutomationProperties.AutomationId="AdminScanButton"
                            AutomationProperties.Name="Scan with administrator rights"
                            Click="AdminScan_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xEA18;" />
                                <TextBlock Text="Scan" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard Description="Windows keeps a list of the programs it has run lately, which only an administrator may read. This asks once and uses it to tell which apps you have not opened." Header="Check when apps were last opened">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE823;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing
                            x:Name="UsageCheckRing"
                            Width="16"
                            Height="16"
                            IsActive="False" />
                        <Button
                            x:Name="UsageCheckButton"
                            AutomationProperties.AutomationId="UsageCheckButton"
                            AutomationProperties.Name="Check when apps were last opened"
                            Click="UsageCheck_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xEA18;" />
                                <TextBlock Text="Check" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <TextBlock
                    Margin="0,20,0,4"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Live figures" />
                <controls:SettingsCard Description="How often memory and processor use is measured. Nothing is measured while the window is minimised." Header="Refresh every">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="RefreshBox"
                        MinWidth="180"
                        AutomationProperties.AutomationId="RefreshBox"
                        AutomationProperties.Name="Refresh every"
                        SelectionChanged="RefreshBox_SelectionChanged">
                        <ComboBoxItem Content="1 second" Tag="1" />
                        <ComboBoxItem Content="2 seconds" Tag="2" />
                        <ComboBoxItem Content="5 seconds" Tag="5" />
                        <ComboBoxItem Content="10 seconds" Tag="10" />
                        <ComboBoxItem Content="Paused" Tag="0" />
                    </ComboBox>
                </controls:SettingsCard>

                <TextBlock
                    Margin="0,20,0,4"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Your data" />
                <controls:SettingsCard x:Name="LogCard" Header="Change log">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE81C;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        AutomationProperties.AutomationId="OpenLogFolderButton"
                        AutomationProperties.Name="Open the change log folder"
                        Click="OpenLogFolder_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE838;" />
                            <TextBlock Text="Open folder" />
                        </StackPanel>
                    </Button>
                </controls:SettingsCard>

                <TextBlock
                    Margin="0,20,0,4"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Updates" />
                <controls:SettingsCard x:Name="UpdateCard" Header="Check for updates">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing
                            x:Name="UpdateRing"
                            Width="16"
                            Height="16"
                            IsActive="False" />
                        <Button
                            x:Name="UpdatePageButton"
                            AutomationProperties.AutomationId="UpdatePageButton"
                            AutomationProperties.Name="Open the download page"
                            Click="UpdatePage_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                <TextBlock Text="Open the download page" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="UpdateCheckButton"
                            AutomationProperties.AutomationId="UpdateCheckButton"
                            AutomationProperties.Name="Check for updates"
                            Click="UpdateCheck_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE895;" />
                                <TextBlock Text="Check" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <TextBlock
                    Margin="0,20,0,4"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="About" />
                <controls:SettingsExpander
                    x:Name="AboutExpander"
                    Header="Dashio">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/AppIcon.ico" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            Padding="24,32,24,24"
                            HorizontalContentAlignment="Stretch"
                            ContentAlignment="Vertical">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <Image
                            Width="96"
                            Height="96"
                            HorizontalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Source="ms-appx:///Assets/AppLogo.png" />
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="Dashio" />
                        <TextBlock
                            MaxWidth="520"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Text="A dashboard for Windows 11: what is running, what is installed, what fills the drive and what starts by itself, grouped by app."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <HyperlinkButton
                                AutomationProperties.AutomationId="AboutSource"
                                AutomationProperties.Name="Source code on GitHub"
                                NavigateUri="https://github.com/EverythingSuckz/Dashio">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE943;" />
                                    <TextBlock Text="Source code" />
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton
                                AutomationProperties.AutomationId="AboutReleases"
                                AutomationProperties.Name="Releases and what changed"
                                NavigateUri="https://github.com/EverythingSuckz/Dashio/releases">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE81C;" />
                                    <TextBlock Text="Releases" />
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton
                                AutomationProperties.AutomationId="AboutIssues"
                                AutomationProperties.Name="Report a problem"
                                NavigateUri="https://github.com/EverythingSuckz/Dashio/issues">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xEBE8;" />
                                    <TextBlock Text="Report a problem" />
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton
                                AutomationProperties.AutomationId="AboutLicense"
                                AutomationProperties.Name="The MIT License"
                                NavigateUri="https://github.com/EverythingSuckz/Dashio/blob/main/LICENSE">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                                    <TextBlock Text="MIT License" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                        <Border
                            Height="1"
                            Margin="0,16,0,12"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8"
                            ToolTipService.ToolTip="Dashio collects nothing. It uses the internet only when you press Check for updates or one of the links.">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE72E;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Private by design" />
                        </StackPanel>
                    </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
