<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dashio.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Dashio.App.Controls"
    xmlns:local="using:Dashio.App"
    xmlns:vm="using:Dashio.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- App cards carry several labels, so they stack name over labels sooner than the default 476. -->
        <x:Double x:Key="SettingsCardWrapThreshold">760</x:Double>

        <!-- The right-click menu of an app. One menu serves every app; the page fills it in and shows it. -->
        <MenuFlyout x:Key="AppMenu">
            <MenuFlyoutItem Click="AppOpen_Click" Text="Open">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="AppToggleAll_Click"
                Tag="toggle"
                Text="Turn off everything">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7E8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="AppCopyName_Click" Text="Copy name">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!-- A small icon with a count: which kinds of item an app has. -->
        <DataTemplate x:Key="KindCountTemplate" x:DataType="vm:KindCount">
            <StackPanel
                Orientation="Horizontal"
                Spacing="4"
                ToolTipService.ToolTip="{x:Bind Description}">
                <FontIcon
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind Glyph}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Count}" />
            </StackPanel>
        </DataTemplate>

        <!-- One app as a row. -->
        <DataTemplate x:Key="AppRowTemplate" x:DataType="vm:AppRowViewModel">
            <app:AppCard
                Activated="AppCard_Activated"
                AutomationProperties.Name="{x:Bind AccessibleName}"
                ContextRequested="App_ContextRequested"
                Tag="{x:Bind}">
                <app:AppCard.Header>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center">
                            <FontIcon
                                FontSize="24"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xECAA;"
                                Visibility="{x:Bind local:Ui.VisibleIfNull(Icon), Mode=OneWay}" />
                            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Publisher}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </app:AppCard.Header>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ItemsRepeater
                        VerticalAlignment="Center"
                        ItemTemplate="{StaticResource KindCountTemplate}"
                        ItemsSource="{x:Bind Kinds}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="12" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <Border
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        Style="{StaticResource BadgeStyle}"
                        ToolTipService.ToolTip="Starts with Windows in a way Task Manager's Startup tab does not list"
                        Visibility="{x:Bind local:Ui.Visible(IsHidden)}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xED1A;" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{StaticResource BadgeTextStyle}"
                                Text="Not in Task Manager" />
                        </StackPanel>
                    </Border>
                    <Border
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        Style="{StaticResource BadgeStyle}"
                        ToolTipService.ToolTip="{x:Bind AdminFoundTip}"
                        Visibility="{x:Bind local:Ui.Visible(IsAdminFound)}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE7EF;" />
                            <TextBlock
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource BadgeTextStyle}"
                                Text="{x:Bind AdminFoundText}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        Style="{StaticResource BadgeStyle}"
                        ToolTipService.ToolTip="{x:Bind ActivityTip, Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Visible(IsActive), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE768;" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Style="{StaticResource BadgeTextStyle}"
                                Text="{x:Bind ActivityText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        MinWidth="112"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind StartsText}"
                        TextAlignment="Right"
                        Visibility="{x:Bind local:Ui.Visible(StartsWithWindows)}" />
                    <TextBlock
                        MinWidth="112"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ItemsText}"
                        TextAlignment="Right"
                        Visibility="{x:Bind local:Ui.Collapsed(StartsWithWindows)}" />
                </StackPanel>
            </app:AppCard>
        </DataTemplate>

        <!-- One app as a tile, for the grid view. -->
        <DataTemplate x:Key="AppTileTemplate" x:DataType="vm:AppRowViewModel">
            <Button
                Padding="16"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind AccessibleName}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Click="AppTile_Click"
                ContextRequested="App_ContextRequested"
                Tag="{x:Bind}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Left">
                            <FontIcon
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xECAA;"
                                Visibility="{x:Bind local:Ui.VisibleIfNull(Icon), Mode=OneWay}" />
                            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
                        </Grid>
                        <ItemsRepeater
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ItemTemplate="{StaticResource KindCountTemplate}"
                            ItemsSource="{x:Bind Kinds}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="12" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <TextBlock
                            MaxLines="2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Publisher}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Border
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            Style="{StaticResource BadgeStyle}"
                            ToolTipService.ToolTip="Starts with Windows in a way Task Manager's Startup tab does not list"
                            Visibility="{x:Bind local:Ui.Visible(IsHidden)}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xED1A;" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource BadgeTextStyle}"
                                    Text="Not in Task Manager" />
                            </StackPanel>
                        </Border>
                        <Border
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            Style="{StaticResource BadgeStyle}"
                            ToolTipService.ToolTip="{x:Bind AdminFoundTip}"
                            Visibility="{x:Bind local:Ui.Visible(IsAdminFound)}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE7EF;" />
                                <TextBlock
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Style="{StaticResource BadgeTextStyle}"
                                    Text="{x:Bind AdminFoundText}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            Style="{StaticResource BadgeStyle}"
                            ToolTipService.ToolTip="{x:Bind ActivityTip, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Visible(IsActive), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Glyph="&#xE768;" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource BadgeTextStyle}"
                                    Text="{x:Bind ActivityText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind StartsText}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind local:Ui.Visible(StartsWithWindows)}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ItemsText}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind local:Ui.Collapsed(StartsWithWindows)}" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Shell" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title on the left, the three headline numbers on the right. -->
        <Grid Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Apps" />
                <TextBlock
                    AutomationProperties.AutomationId="AppsSummary"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Each number shows a spinner until the first scan has finished. -->
            <StackPanel
                x:Name="StatsPanel"
                Grid.Row="1"
                Margin="0,16,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="32">
                <StackPanel
                    AutomationProperties.AutomationId="StatAtStartup"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Border Style="{StaticResource IconTileStyle}">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE7E8;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <Grid Height="28">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.AtStartupCount, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Collapsed(ViewModel.IsLoading), Mode=OneWay}" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Left"
                                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="apps start with Windows" />
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    AutomationProperties.AutomationId="StatHidden"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Border Style="{StaticResource IconTileStyle}">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xED1A;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <Grid Height="28">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.HiddenCount, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Collapsed(ViewModel.IsLoading), Mode=OneWay}" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Left"
                                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="not in Task Manager" />
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    AutomationProperties.AutomationId="StatRunning"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Border Style="{StaticResource IconTileStyle}">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE768;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <Grid Height="28">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.RunningCount, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Collapsed(ViewModel.IsLoading), Mode=OneWay}" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Left"
                                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="services running now" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Margin="24,16,36,8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar
                x:Name="FilterBar"
                AutomationProperties.Name="Filter apps"
                SelectionChanged="FilterBar_SelectionChanged">
                <SelectorBarItem
                    x:Name="FilterAll"
                    AutomationProperties.AutomationId="FilterAll"
                    IsSelected="True"
                    Text="{x:Bind ViewModel.AllLabel, Mode=OneWay}" />
                <SelectorBarItem
                    x:Name="FilterAtStartup"
                    AutomationProperties.AutomationId="FilterAtStartup"
                    Text="{x:Bind ViewModel.AtStartupLabel, Mode=OneWay}" />
                <SelectorBarItem
                    x:Name="FilterNotInTaskManager"
                    AutomationProperties.AutomationId="FilterNotInTaskManager"
                    Text="{x:Bind ViewModel.NotInTaskManagerLabel, Mode=OneWay}" />
                <!-- Appears once the admin scan has found something. -->
                <SelectorBarItem
                    x:Name="FilterAdminScan"
                    AutomationProperties.AutomationId="FilterAdminScan"
                    Text="{x:Bind ViewModel.AdminScanLabel, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Visible(ViewModel.HasAdminFound), Mode=OneWay}" />
            </SelectorBar>

            <!-- Switches between rows and tiles. It shows the view it will switch to. -->
            <Button
                x:Name="LayoutToggle"
                Grid.Column="1"
                Width="36"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="LayoutToggle"
                Click="LayoutToggle_Click">
                <Grid>
                    <FontIcon
                        x:Name="GridIcon"
                        FontSize="16"
                        Glyph="&#xF0E2;" />
                    <FontIcon
                        x:Name="ListIcon"
                        FontSize="16"
                        Glyph="&#xEA37;"
                        Visibility="Collapsed" />
                </Grid>
            </Button>

            <DropDownButton
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ViewMenu"
                AutomationProperties.Name="View">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                    <TextBlock Text="View" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <RadioMenuFlyoutItem
                            AutomationProperties.AutomationId="SortMostAtStartup"
                            Click="SortMostAtStartup_Click"
                            GroupName="Sort"
                            IsChecked="True"
                            Text="Most at startup first" />
                        <RadioMenuFlyoutItem
                            AutomationProperties.AutomationId="SortByName"
                            Click="SortName_Click"
                            GroupName="Sort"
                            Text="Name" />
                        <RadioMenuFlyoutItem
                            AutomationProperties.AutomationId="SortByMemory"
                            Click="SortMemory_Click"
                            GroupName="Sort"
                            Text="Most memory first" />
                        <RadioMenuFlyoutItem
                            AutomationProperties.AutomationId="SortByCpu"
                            Click="SortCpu_Click"
                            GroupName="Sort"
                            Text="Most processor use first" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem
                            x:Name="ShowWindowsItem"
                            AutomationProperties.AutomationId="ShowWindowsItem"
                            Click="ShowWindows_Click"
                            Text="Show Windows components" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <ScrollViewer Grid.Row="2" Visibility="{x:Bind local:Ui.Collapsed(ViewModel.IsLoading), Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The apps, as rows or as tiles. Only one of the two is shown. -->
                <Grid
                    x:Name="ListHost"
                    Margin="{StaticResource PageContentMargin}"
                    VerticalAlignment="Top">
                    <ItemsRepeater
                        x:Name="AppList"
                        ItemTemplate="{StaticResource AppRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Apps}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <ItemsRepeater
                        x:Name="AppGrid"
                        ItemTemplate="{StaticResource AppTileTemplate}"
                        ItemsSource="{x:Bind ViewModel.Apps}"
                        Visibility="Collapsed">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="8"
                                MinItemHeight="212"
                                MinItemWidth="280"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Grid>

                <!-- Side panel: how to read the list. -->
                <StackPanel
                    x:Name="SidePanel"
                    Grid.Column="1"
                    Width="{StaticResource SidePanelWidth}"
                    Margin="0,0,36,24"
                    VerticalAlignment="Top"
                    Spacing="16"
                    Visibility="Collapsed">
                    <!-- Each row: the term in bold, then what it means in grey. -->
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock
                                Padding="20,20,20,16"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Good to know" />
                            <Grid Style="{StaticResource PanelRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource RowIconTileStyle}">
                                    <FontIcon
                                        FontSize="20"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Glyph="&#xED1A;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Not in Task Manager" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="The app starts with Windows through a service or task, which the Startup tab does not list."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource PanelRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource RowIconTileStyle}">
                                    <FontIcon FontSize="20" Glyph="&#xEA18;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="The shield" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Changing this needs administrator permission. Windows asks once per batch."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource PanelRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource RowIconTileStyle}">
                                    <FontIcon FontSize="20" Glyph="&#xE7A7;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Nothing is deleted" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Switches only turn things off and on, and History can undo every change."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- First scan -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind local:Ui.Visible(ViewModel.IsLoading), Mode=OneWay}">
            <ProgressRing
                Width="32"
                Height="32"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="ScanStatus"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind State.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!-- Nothing matches -->
        <StackPanel
            Grid.Row="2"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:Ui.Visible(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE721;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
