<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dashio.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dashio.App"
    xmlns:vm="using:Dashio.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- The right-click menu of an app. One menu serves every app; the page fills it in and shows it. -->
        <MenuFlyout x:Key="AppMenu">
            <MenuFlyoutItem Click="AppOpen_Click" Text="Open">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="AppToggleAll_Click"
                Tag="toggle"
                Text="Turn off everything it starts">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7E8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="AppEnd_Click"
                Tag="end"
                Text="End app">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE711;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="AppReveal_Click"
                Tag="file"
                Text="Show file in File Explorer">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="AppCopyName_Click" Text="Copy name">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="AppUninstall_Click"
                Tag="uninstall"
                Text="Uninstall">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!-- One app as a row. The column widths match the headings above the list. -->
        <DataTemplate x:Key="AppRowTemplate" x:DataType="vm:AppRowViewModel">
            <Grid AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="{x:Bind Columns.SizeWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Columns.LastOpenedWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center">
                    <FontIcon
                        FontSize="24"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xECAA;"
                        Visibility="{x:Bind local:Ui.VisibleIfNull(Icon), Mode=OneWay}" />
                    <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,16,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Publisher, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Running now: a dot and the memory in use. -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    ToolTipService.ToolTip="{x:Bind RunningTip, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Visible(IsRunning), Mode=OneWay}">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind RunningText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind local:Ui.Collapsed(IsRunning), Mode=OneWay}">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                        StrokeThickness="1" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Not running" />
                </StackPanel>

                <!-- What starts by itself, with a mark for the ways that are easy to miss. -->
                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        ToolTipService.ToolTip="{x:Bind StartsTip, Mode=OneWay}">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE7E8;"
                            Visibility="{x:Bind local:Ui.Visible(StartsWithWindows), Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind StartsText, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Visible(StartsWithWindows), Mode=OneWay}" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE7E8;"
                            Visibility="{x:Bind local:Ui.Visible(StartsNothing), Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind StartsText, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Visible(StartsNothing), Mode=OneWay}" />
                    </StackPanel>
                    <FontIcon
                        AutomationProperties.Name="Not in Task Manager"
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xED1A;"
                        ToolTipService.ToolTip="Starts with Windows in a way Task Manager's Startup tab does not list"
                        Visibility="{x:Bind local:Ui.Visible(IsHidden), Mode=OneWay}" />
                    <FontIcon
                        AutomationProperties.Name="Found by the admin scan"
                        FontSize="14"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE7EF;"
                        ToolTipService.ToolTip="{x:Bind AdminFoundTip, Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Visible(IsAdminFound), Mode=OneWay}" />
                </StackPanel>

                <Grid Grid.Column="4" Visibility="{x:Bind local:Ui.Visible(Columns.ShowSize), Mode=OneWay}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind SizeText, Mode=OneWay}"
                        TextAlignment="Right"
                        ToolTipService.ToolTip="{x:Bind SizeTip, Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Visible(HasSize), Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Unknown"
                        TextAlignment="Right"
                        ToolTipService.ToolTip="Windows does not list this as an installed app, so there is no folder to measure"
                        Visibility="{x:Bind local:Ui.Collapsed(HasSize), Mode=OneWay}" />
                </Grid>

                <StackPanel
                    Grid.Column="5"
                    Margin="24,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind local:Ui.Visible(Columns.ShowLastOpened), Mode=OneWay}">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE823;"
                        Visibility="{x:Bind local:Ui.Visible(IsUnused), Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind LastOpenedText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind local:Ui.Visible(HasLastOpened), Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind NoLastOpenedText, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind NoLastOpenedTip, Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Collapsed(HasLastOpened), Mode=OneWay}" />
                </StackPanel>

                <FontIcon
                    Grid.Column="6"
                    HorizontalAlignment="Right"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE76C;" />
            </Grid>
        </DataTemplate>

        <!-- One app as a tile, for the grid view. -->
        <DataTemplate x:Key="AppTileTemplate" x:DataType="vm:AppRowViewModel">
            <Button
                Padding="16"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Click="AppTile_Click"
                ContextRequested="AppTile_ContextRequested"
                Tag="{x:Bind}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Left">
                            <FontIcon
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xECAA;"
                                Visibility="{x:Bind local:Ui.VisibleIfNull(Icon), Mode=OneWay}" />
                            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
                        </Grid>
                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                AutomationProperties.Name="Not in Task Manager"
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xED1A;"
                                ToolTipService.ToolTip="Starts with Windows in a way Task Manager's Startup tab does not list"
                                Visibility="{x:Bind local:Ui.Visible(IsHidden), Mode=OneWay}" />
                            <FontIcon
                                AutomationProperties.Name="Found by the admin scan"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE7EF;"
                                ToolTipService.ToolTip="{x:Bind AdminFoundTip, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Visible(IsAdminFound), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <TextBlock
                            MaxLines="2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Publisher, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- The same facts as the columns of the list, as one quiet line. -->
                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="12">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            ToolTipService.ToolTip="{x:Bind RunningTip, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Visible(IsRunning), Mode=OneWay}">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind RunningText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            ToolTipService.ToolTip="{x:Bind StartsTip, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Visible(StartsWithWindows), Mode=OneWay}">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE7E8;" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind StartsText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind SizeText, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind SizeTip, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Shell" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Title on the left, the filter box on the right. -->
        <Grid
            Grid.ColumnSpan="2"
            Margin="{StaticResource PageHeaderMargin}"
            ColumnSpacing="24"
            RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Apps" />
                <TextBlock
                    AutomationProperties.AutomationId="AppsSummary"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <!-- Runtimes, drivers and programs that are only running are left out unless asked for. -->
                <TextBlock
                    AutomationProperties.AutomationId="AppsComponents"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:Ui.Visible(ViewModel.HasComponents), Mode=OneWay}">
                    <Run Text="{x:Bind ViewModel.ComponentsText, Mode=OneWay}" />
                    <Hyperlink Click="ComponentsLink_Click" UnderlineStyle="None">
                        <Run Text="{x:Bind ViewModel.ComponentsAction, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <AutoSuggestBox
                x:Name="FilterBox"
                Grid.Column="1"
                Width="280"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="AppsFilter"
                AutomationProperties.Name="Filter apps"
                PlaceholderText="Filter by name"
                QueryIcon="Filter"
                TextChanged="FilterBox_TextChanged" />
        </Grid>

        <Grid
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="24,16,36,8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar
                x:Name="FilterBar"
                AutomationProperties.Name="Which apps to show"
                SelectionChanged="FilterBar_SelectionChanged">
                <SelectorBarItem
                    x:Name="FilterAll"
                    AutomationProperties.AutomationId="FilterAll"
                    IsSelected="True"
                    Text="{x:Bind ViewModel.AllLabel, Mode=OneWay}" />
                <SelectorBarItem
                    x:Name="FilterRunning"
                    AutomationProperties.AutomationId="FilterRunning"
                    Text="{x:Bind ViewModel.RunningLabel, Mode=OneWay}" />
                <SelectorBarItem
                    x:Name="FilterAtStartup"
                    AutomationProperties.AutomationId="FilterAtStartup"
                    Text="{x:Bind ViewModel.AtStartupLabel, Mode=OneWay}" />
                <SelectorBarItem
                    x:Name="FilterNotInTaskManager"
                    AutomationProperties.AutomationId="FilterNotInTaskManager"
                    Text="{x:Bind ViewModel.NotInTaskManagerLabel, Mode=OneWay}" />
                <SelectorBarItem
                    x:Name="FilterUnused"
                    AutomationProperties.AutomationId="FilterUnused"
                    Text="{x:Bind ViewModel.UnusedLabel, Mode=OneWay}" />
                <!-- Appears once the admin scan has found something. -->
                <SelectorBarItem
                    x:Name="FilterAdminScan"
                    AutomationProperties.AutomationId="FilterAdminScan"
                    Text="{x:Bind ViewModel.AdminScanLabel, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Visible(ViewModel.HasAdminFound), Mode=OneWay}" />
            </SelectorBar>

            <!-- Switches between rows and tiles. It shows the view it will switch to. -->
            <Button
                x:Name="LayoutToggle"
                Grid.Column="1"
                Width="36"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="LayoutToggle"
                Click="LayoutToggle_Click">
                <Grid>
                    <FontIcon
                        x:Name="GridIcon"
                        FontSize="16"
                        Glyph="&#xF0E2;" />
                    <FontIcon
                        x:Name="ListIcon"
                        FontSize="16"
                        Glyph="&#xEA37;"
                        Visibility="Collapsed" />
                </Grid>
            </Button>

            <DropDownButton
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ViewMenu"
                AutomationProperties.Name="View">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                    <TextBlock Text="View" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <RadioMenuFlyoutItem
                            x:Name="SortNameItem"
                            AutomationProperties.AutomationId="SortByName"
                            Click="SortItem_Click"
                            GroupName="Sort"
                            IsChecked="True"
                            Tag="Name"
                            Text="Name" />
                        <RadioMenuFlyoutItem
                            x:Name="SortRunningItem"
                            AutomationProperties.AutomationId="SortByMemory"
                            Click="SortItem_Click"
                            GroupName="Sort"
                            Tag="Running"
                            Text="Most memory first" />
                        <RadioMenuFlyoutItem
                            x:Name="SortStartsItem"
                            AutomationProperties.AutomationId="SortMostAtStartup"
                            Click="SortItem_Click"
                            GroupName="Sort"
                            Tag="Starts"
                            Text="Most at startup first" />
                        <RadioMenuFlyoutItem
                            x:Name="SortSizeItem"
                            AutomationProperties.AutomationId="SortBySize"
                            Click="SortItem_Click"
                            GroupName="Sort"
                            Tag="Size"
                            Text="Largest first" />
                        <RadioMenuFlyoutItem
                            x:Name="SortLastOpenedItem"
                            AutomationProperties.AutomationId="SortByLastOpened"
                            Click="SortItem_Click"
                            GroupName="Sort"
                            Tag="LastOpened"
                            Text="Longest unopened first" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem
                            x:Name="ShowComponentsItem"
                            AutomationProperties.AutomationId="ShowComponentsItem"
                            Click="ShowComponents_Click"
                            Text="Show components and background programs" />
                        <ToggleMenuFlyoutItem
                            x:Name="ShowWindowsItem"
                            AutomationProperties.AutomationId="ShowWindowsItem"
                            Click="ShowWindows_Click"
                            Text="Show Windows components" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- What "not opened lately" rests on. Shown on that tab. -->
        <InfoBar
            x:Name="EvidenceBar"
            Title="{x:Bind ViewModel.EvidenceTitle, Mode=OneWay}"
            Grid.Row="2"
            Margin="36,0,36,8"
            AutomationProperties.AutomationId="AppsEvidence"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.ShowEvidence, Mode=OneWay}"
            Message="{x:Bind ViewModel.EvidenceText, Mode=OneWay}"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button
                    x:Name="AdminCheckButton"
                    AutomationProperties.AutomationId="AppsAdminCheck"
                    AutomationProperties.Name="Grant administrator access"
                    Click="AdminCheck_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind local:Ui.Visible(ViewModel.NeedsAdminCheck), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xEA18;" />
                        <TextBlock Text="Grant access" />
                    </StackPanel>
                </Button>
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Column headings. Pressing one sorts by it. -->
        <Grid
            x:Name="ColumnHeader"
            Grid.Row="3"
            Margin="36,0,36,0"
            Padding="16,4,16,4"
            Style="{StaticResource TableHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="{x:Bind ViewModel.Columns.SizeWidth, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Columns.LastOpenedWidth, Mode=OneWay}" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="NameHeader"
                AutomationProperties.AutomationId="AppsSortName"
                AutomationProperties.Name="Sort by name"
                Click="Header_Click"
                Content="App"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="Name" />
            <Button
                x:Name="RunningHeader"
                Grid.Column="1"
                AutomationProperties.AutomationId="AppsSortRunning"
                AutomationProperties.Name="Sort by memory in use"
                Click="Header_Click"
                Content="Running"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="Running"
                ToolTipService.ToolTip="Whether the app is running now, and the memory it is using" />
            <Button
                x:Name="StartsHeader"
                Grid.Column="2"
                AutomationProperties.AutomationId="AppsSortStarts"
                AutomationProperties.Name="Sort by what starts with Windows"
                Click="Header_Click"
                Content="Starts"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="Starts"
                ToolTipService.ToolTip="How many of the things the app set up start with Windows" />
            <Button
                x:Name="SizeHeader"
                Grid.Column="3"
                AutomationProperties.AutomationId="AppsSortSize"
                AutomationProperties.Name="Sort by size"
                Click="Header_Click"
                Content="Size"
                Style="{StaticResource ColumnHeaderRightButtonStyle}"
                Tag="Size"
                ToolTipService.ToolTip="The app's own files plus the data it keeps"
                Visibility="{x:Bind local:Ui.Visible(ViewModel.Columns.ShowSize), Mode=OneWay}" />
            <Button
                x:Name="LastOpenedHeader"
                Grid.Column="4"
                Margin="16,0,0,0"
                AutomationProperties.AutomationId="AppsSortLastOpened"
                AutomationProperties.Name="Sort by when it was last opened"
                Click="Header_Click"
                Content="Last opened"
                Style="{StaticResource ColumnHeaderButtonStyle}"
                Tag="LastOpened"
                ToolTipService.ToolTip="When the app itself was last started, not its background services"
                Visibility="{x:Bind local:Ui.Visible(ViewModel.Columns.ShowLastOpened), Mode=OneWay}" />
        </Grid>

        <!-- The apps, as rows or as tiles. Only one of the two is shown. -->
        <ListView
            x:Name="AppList"
            Grid.Row="4"
            Padding="36,4,36,24"
            AutomationProperties.AutomationId="AppList"
            AutomationProperties.Name="Apps"
            ContextRequested="AppList_ContextRequested"
            IsItemClickEnabled="True"
            ItemClick="AppRow_Click"
            ItemTemplate="{StaticResource AppRowTemplate}"
            ItemsSource="{x:Bind ViewModel.Apps}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="16,0,16,0" />
                    <Setter Property="MinHeight" Value="56" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <ScrollViewer
            x:Name="GridScroller"
            Grid.Row="3"
            Grid.RowSpan="2"
            Visibility="Collapsed">
            <ItemsRepeater
                x:Name="AppGrid"
                Margin="{StaticResource PageContentMargin}"
                ItemTemplate="{StaticResource AppTileTemplate}"
                ItemsSource="{x:Bind ViewModel.Apps}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="8"
                        MinItemHeight="176"
                        MinItemWidth="260"
                        MinRowSpacing="8" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Side panel: how to read the list. -->
        <StackPanel
            x:Name="SidePanel"
            Grid.Row="2"
            Grid.RowSpan="3"
            Grid.Column="1"
            Width="380"
            Padding="0,0,36,24"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <!-- Each row: the term in bold, then what it means in grey. -->
            <Border Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock
                        Padding="20,20,20,16"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Reading the list" />
                    <Grid Style="{StaticResource PanelRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource RowIconTileStyle}">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Running" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Something of the app is running now, with the memory it is using."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource PanelRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource RowIconTileStyle}">
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE7E8;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Starts" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="How many of the services, tasks and startup entries the app set up start with Windows. Open the app to switch them."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource PanelRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource RowIconTileStyle}">
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xED1A;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Not in Task Manager" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="The app starts with Windows through a service or task, which the Startup tab does not list."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource PanelRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource RowIconTileStyle}">
                            <FontIcon FontSize="20" Glyph="&#xE823;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Last opened" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="When the app itself was last started, not its background services. Blank for things with nothing to open, such as drivers."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource PanelRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource RowIconTileStyle}">
                            <FontIcon FontSize="20" Glyph="&#xE7A7;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Nothing is deleted" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Switches only turn things off and on, and History can undo every change."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource PanelRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource RowIconTileStyle}">
                            <FontIcon FontSize="20" Glyph="&#xEA86;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Components" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Runtimes, drivers and codecs that start nothing, and programs that run without being installed, are left out. View brings them back, and the filter box finds them by name."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- First scan -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind local:Ui.Visible(ViewModel.IsLoading), Mode=OneWay}">
            <ProgressRing
                Width="32"
                Height="32"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="ScanStatus"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind State.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!-- Nothing matches -->
        <StackPanel
            Grid.Row="4"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:Ui.Visible(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE721;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
