<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Dashio.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HighContrastAdjustment="None">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Page metrics, on the 4 px grid. Page width is set in code; see Ui.FitToPage. -->
            <x:Double x:Key="SidePanelWidth">344</x:Double>
            <Thickness x:Key="PageHeaderMargin">36,24,36,0</Thickness>
            <Thickness x:Key="PageContentMargin">36,0,36,24</Thickness>

            <!-- A titled panel, like the ones on the Windows Settings home page. -->
            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>

            <!-- The accent square behind a headline icon. -->
            <Style x:Key="IconTileStyle" TargetType="Border">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- The soft square behind a row's icon in a panel. -->
            <Style x:Key="RowIconTileStyle" TargetType="Border">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A row inside a panel, separated from the one above by a hairline. -->
            <Style x:Key="PanelRowStyle" TargetType="Grid">
                <Setter Property="Padding" Value="20,14,20,14" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>

            <!-- A small label such as "2 running". Colours are set where it is used. -->
            <Style x:Key="BadgeStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="8,2,8,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style
                x:Key="BadgeTextStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <!-- The strip of column headings above a table. -->
            <Style x:Key="TableHeaderStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>

            <!-- A column heading that sorts when pressed. -->
            <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <!-- The negative margin lets the hover highlight extend left while the label stays on the column edge. -->
                <Setter Property="Margin" Value="-8,0,0,0" />
                <Setter Property="Padding" Value="8,6,8,6" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- The same, over a column of figures that line up on the right. -->
            <Style
                x:Key="ColumnHeaderRightButtonStyle"
                BasedOn="{StaticResource ColumnHeaderButtonStyle}"
                TargetType="Button">
                <Setter Property="Margin" Value="0,0,-8,0" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>

            <!-- A small borderless button for an action on one row of a table. -->
            <Style x:Key="TableActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Paths, commands and registry keys. -->
            <FontFamily x:Key="CodeFontFamily">Cascadia Mono, Consolas</FontFamily>

            <!-- A value shown inside an expanded item: wraps and can be copied. -->
            <Style
                x:Key="DetailValueStyle"
                BasedOn="{StaticResource BodyTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
