<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Dashio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dashio.App"
    xmlns:services="using:Dashio.App.Services"
    Title="Dashio">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- The app only uses theme colours, so high contrast needs no automatic boxes drawn behind text. -->
    <Grid
        x:Name="RootGrid"
        HighContrastAdjustment="None"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
            <KeyboardAccelerator
                Key="F"
                Invoked="Filter_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="E"
                Invoked="Search_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Left"
                Invoked="Back_Invoked"
                Modifiers="Menu" />
        </Grid.KeyboardAccelerators>

        <TitleBar
            x:Name="AppTitleBar"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <!-- The name is a button: pressing it goes back to Overview. -->
            <TitleBar.LeftHeader>
                <Button
                    x:Name="HomeButton"
                    Padding="8,6,12,6"
                    AutomationProperties.AutomationId="HomeButton"
                    AutomationProperties.Name="Dashio, go to Overview"
                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                    BorderThickness="0"
                    Click="Home_Click"
                    ToolTipService.ToolTip="Go to Overview">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image
                            Width="16"
                            Height="16"
                            Source="ms-appx:///Assets/AppIcon.ico" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Dashio" />
                    </StackPanel>
                </Button>
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <!-- Finds an app, a running program, a startup item, a page or a setting, and goes there. -->
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="280"
                    MaxWidth="480"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SearchBox"
                    AutomationProperties.Name="Search Dashio"
                    CornerRadius="16"
                    PlaceholderText="Search apps, processes and settings"
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    TextChanged="SearchBox_TextChanged"
                    ToolTipService.ToolTip="Search (Ctrl+E)"
                    UpdateTextOnSelect="False">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="services:SearchResult">
                            <Grid
                                Padding="0,6,0,6"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind Glyph}"
                                        Visibility="{x:Bind local:Ui.VisibleIfNull(Icon), Mode=OneWay}" />
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Caption}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!-- The scan repeats by itself; this only shows that one is running. -->
                    <ProgressRing
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Scanning"
                        IsActive="{x:Bind State.IsScanning, Mode=OneWay}"
                        ToolTipService.ToolTip="Looking at what is installed and what starts by itself" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            ItemInvoked="NavView_ItemInvoked"
            OpenPaneLength="232"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="OverviewItem"
                    AutomationProperties.AutomationId="NavOverview"
                    Content="Overview"
                    Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ProcessesItem"
                    AutomationProperties.AutomationId="NavProcesses"
                    Content="Processes"
                    Tag="processes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AppsItem"
                    AutomationProperties.AutomationId="NavApps"
                    Content="Apps"
                    Tag="apps">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="StorageItem"
                    AutomationProperties.AutomationId="NavStorage"
                    Content="Storage"
                    Tag="storage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="StartupItem"
                    AutomationProperties.AutomationId="NavStartup"
                    Content="Startup"
                    Tag="startup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="HistoryItem"
                    AutomationProperties.AutomationId="NavHistory"
                    Content="History"
                    Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    x:Name="BannerPanel"
                    Padding="36,12,36,0"
                    HorizontalAlignment="Center"
                    Spacing="4">
                    <!-- Shown while a batch of changes is being applied, including while the admin prompt is open. -->
                    <InfoBar
                        x:Name="BusyBar"
                        AutomationProperties.AutomationId="BusyBar"
                        AutomationProperties.Name="Applying your changes"
                        IsClosable="False"
                        IsIconVisible="False"
                        IsOpen="False"
                        Severity="Informational">
                        <!-- A spinner takes the place of the icon, so the text goes in the content too. -->
                        <InfoBar.Content>
                            <Grid Margin="0,12,0,12" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind BusyBar.IsOpen, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Applying your changes" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="If Windows is asking for administrator permission, answer it to continue."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </InfoBar.Content>
                    </InfoBar>
                    <!-- Stays for as long as an uninstall is underway, whichever page is showing. -->
                    <InfoBar
                        x:Name="UninstallBar"
                        AutomationProperties.AutomationId="UninstallBar"
                        IsClosable="False"
                        IsIconVisible="False"
                        IsOpen="False"
                        Severity="Informational">
                        <InfoBar.Content>
                            <Grid Margin="0,12,0,12" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind UninstallBar.IsOpen, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="UninstallTitle"
                                        AutomationProperties.AutomationId="UninstallTitle"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="UninstallDetail"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </InfoBar.Content>
                    </InfoBar>
                    <InfoBar
                        x:Name="ErrorBar"
                        Title="Some things could not be read"
                        AutomationProperties.AutomationId="ErrorBar"
                        Closing="Bar_Closing"
                        IsOpen="False"
                        Severity="Warning" />
                    <InfoBar
                        x:Name="NoticeBar"
                        AutomationProperties.AutomationId="NoticeBar"
                        Closing="Bar_Closing"
                        IsOpen="False">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="NoticeUndoButton"
                                AutomationProperties.AutomationId="NoticeUndoButton"
                                AutomationProperties.Name="Undo"
                                Click="NoticeUndo_Click"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                                    <TextBlock Text="Undo" />
                                </StackPanel>
                            </Button>
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <!-- The page glides to its new place when a banner appears or goes, instead of jumping. -->
                <Frame x:Name="NavFrame" Grid.Row="1">
                    <Frame.Transitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </Frame.Transitions>
                </Frame>

                <!-- Appears when the user has flipped switches that are not applied yet. -->
                <Grid
                    x:Name="PendingBar"
                    Grid.Row="2"
                    Padding="36,12,36,12"
                    AutomationProperties.AutomationId="PendingBar"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="12"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE70F;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="PendingTitle"
                            AutomationProperties.AutomationId="PendingTitle"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="PendingDetail"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="DiscardButton"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="DiscardButton"
                        AutomationProperties.Name="Discard"
                        Click="Discard_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                            <TextBlock Text="Discard" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ApplyButton"
                        Grid.Column="3"
                        AutomationProperties.AutomationId="ApplyButton"
                        AutomationProperties.Name="Review and apply"
                        Click="Apply_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE73E;" />
                            <TextBlock Text="Review and apply" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
