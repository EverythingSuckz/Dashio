<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DashioTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(DashioMinVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(DashioMinVersion)</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Attribution\attribution-overrides.json" />
    <InternalsVisibleTo Include="Dashio.Core.Tests" />
  </ItemGroup>

</Project>
